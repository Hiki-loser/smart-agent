# Multi-stage build for SmartAgent Gateway
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build
COPY backend/pom.xml ./pom.xml
COPY backend/common/pom.xml ./common/pom.xml
COPY backend/gateway/pom.xml ./gateway/pom.xml
COPY backend/user/pom.xml ./user/pom.xml
COPY backend/chat/pom.xml ./chat/pom.xml

# Download dependencies (layer cache)
RUN mvn dependency:go-offline -pl gateway -am -q

COPY backend/common/src ./common/src
COPY backend/gateway/src ./gateway/src

RUN mvn package -DskipTests -pl gateway -am -q

FROM eclipse-temurin:21-jre-alpine

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

WORKDIR /app
COPY --from=builder /build/gateway/target/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
